{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "akademia-super-zdrowia-gra.vercel.app" }],
      "destination": "https://gra.akademiasuperzdrowia.pl/:path*",
      "permanent": true
    },
    { "source": "/komiks", "destination": "/misja-energia/komiks/", "permanent": true },
    { "source": "/komiks/", "destination": "/misja-energia/komiks/", "permanent": true },
    { "source": "/manifest.webmanifest", "destination": "/misja-energia/manifest.webmanifest", "permanent": true },
    { "source": "/assets/:path*", "destination": "/misja-energia/assets/:path*", "permanent": true },
    { "source": "/css/:path*", "destination": "/misja-energia/css/:path*", "permanent": true },
    { "source": "/js/:path*", "destination": "/misja-energia/js/:path*", "permanent": true }
  ]
}
